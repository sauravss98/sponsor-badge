{
  "manifest_version": 3,
  "name": "Sponsor Badge",
  "version": "0.1.0",
  "description": "Shows whether a UK employer is on the Home Office register of licensed visa sponsors.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://uk.indeed.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sponsor Badge"
  }
}
